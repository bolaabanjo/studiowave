{
  "expo": {
    "name": "Studiowave",
    "slug": "studiowave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cencori.studio",
      "backgroundColor": "#000000",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cencori.studio",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-font",
      "expo-audio",
      "expo-sharing",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Studiowave uses the camera to scan tickets at the door and to photograph your menu or price list.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Studiowave uses your photos for your profile picture, event flyers, and reading your menu or product list.",
          "cameraPermission": "Studiowave uses the camera to photograph your menu or price list."
        }
      ],
      "expo-asset",
      "expo-system-ui"
    ],
    "scheme": "cencori-studio",
    "experiments": {
      "typedRoutes": false
    },
    "backgroundColor": "#000000",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5e0439be-0de1-4ba8-bcf8-d8c4571759dc"
      }
    },
    "owner": "bolaabanjo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5e0439be-0de1-4ba8-bcf8-d8c4571759dc"
    }
  }
}
