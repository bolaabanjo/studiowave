{
  "expo": {
    "name": "Studio",
    "slug": "studio-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cencori.studio",
      "backgroundColor": "#000000"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cencori.studio"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "expo-font",
      "expo-audio",
      "expo-sharing",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Studio uses the camera to scan tickets at the door and to photograph your menu or price list.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Studio uses your photos for your profile picture, event flyers, and reading your menu or product list.",
          "cameraPermission": "Studio uses the camera to photograph your menu or price list."
        }
      ],
      "expo-asset",
      "expo-system-ui"
    ],
    "scheme": "cencori-studio",
    "experiments": {
      "typedRoutes": false
    },
    "backgroundColor": "#000000"
  }
}